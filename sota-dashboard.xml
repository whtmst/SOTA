<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="sota-dashboard.lua" />

	<!-- Кириллические шрифты -->
	<Font name="SOTA_Font_Title" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="16" />
		<Color r="1" g="1" b="1" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Normal" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="12" />
		<Color r="1" g="1" b="1" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Small" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="10" />
		<Color r="0.7" g="0.7" b="0.7" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Orange" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="12" />
		<Color r="0.925" g="0.243" b="0.031" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>

	<!-- SOTA Dashboard -->
	<Frame name="DashboardUIFrame" parent="UIParent" toplevel="true" hidden="true">
		<Size>
			<AbsDimension x="280" y="85" />
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset x="312" y="-118" />
			</Anchor>
		</Anchors>
		<Frames>
			<!-- Общая панель с кнопками (10 кнопок в 2 ряда) -->
			<Frame name="$parentButtons">
				<Size>
				<AbsDimension x="232" y="90" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
						<AbsDimension x="24" y="22" />
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop
                    edgeFile="Interface\Tooltips\UI-Tooltip-Border"
                    tile="true"
                    bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                >
					<BackgroundInsets>
						<AbsInset left="4" right="4" top="4" bottom="4" />
					</BackgroundInsets>
					<EdgeSize>
						<AbsValue val="16" />
					</EdgeSize>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
				</Backdrop>
				<Frames>
					<!-- ВЕРХНИЙ РЯД (бонусы DKP) -->
					<!-- Button 1: Приветственное DKP -->
					<Button name="$parentWelcomeDKPButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="12" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Ability_Mage_IncantersAbsorbtion.blp" />
						<PushedTexture file="Interface\ICONS\Ability_Mage_IncantersAbsorbtion.blp" />
						<Scripts>
							<OnClick>
								SOTA_WelcomeDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ ПРИВЕТСТВЕННОЕ DKP");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 2: Без вайпов -->
					<Button name="$parentNoWipeButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="56" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_Crusade.blp" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_Crusade.blp" />
						<Scripts>
							<OnClick>
								SOTA_NoWipeDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА ПРОХОД БЕЗ ВАЙПОВ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 3: Без смертей -->
					<Button name="$parentNoDeathButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="100" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_Redemption.blp" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_Redemption.blp" />
						<Scripts>
							<OnClick>
								SOTA_NoDeathDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА ПРОХОД БЕЗ СМЕРТЕЙ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 4: Рекорд времени -->
					<Button name="$parentRecordButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="144" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_BorrowedTime.blp" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_BorrowedTime.blp" />
						<Scripts>
							<OnClick>
								SOTA_RecordDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА РЕКОРД ВРЕМЕНИ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 5: Начислить DKP рейду -->
					<Button name="$parentRaidDKPButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="188" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_Coin_02.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Coin_02.blp" />
						<Scripts>
							<OnClick>
								SOTA_ShareBossDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ДОБАВИТЬ УКАЗАННОЕ КОЛИЧЕСТВО DKP КАЖДОМУ УЧАСТНИКУ РЕЙДА");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>

					<!-- НИЖНИЙ РЯД (основные функции) -->
					<!-- Button 6: Запрос мастер лутера -->
					<Button name="$parentSOTAMasterButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="12" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_SpiritualGuidence.blp" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_SpiritualGuidence.blp" />
						<Scripts>
							<OnClick>
								SOTA_RequestSOTAMaster();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ЗАПРОСИТЬ СТАТУС МАСТЕР-ЛУТЕРА");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 7: Пустышка -->
					<Button name="$parentPlaceholder1Button" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="56" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_QuestionMark.blp" />
						<PushedTexture file="Interface\ICONS\INV_Misc_QuestionMark.blp" />
						<Scripts>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "СВОБОДНАЯ КНОПКА (ЗАГЛУШКА)");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 8: Журнал транзакций -->
					<Button name="$parentTransactionLogButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="100" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\BtnHolyScriptures.blp" />
						<PushedTexture file="Interface\ICONS\BtnHolyScriptures.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenTransauctionUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ЖУРНАЛ ТРАНЗАКЦИЙ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 9: Очередь в рейд -->
					<Button name="$parentRaidQueueButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="144" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Achievement_Rat.blp" />
						<PushedTexture file="Interface\ICONS\Achievement_Rat.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenRaidQueueUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ОЧЕРЕДЬ В РЕЙД");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 10: Настройки -->
					<Button name="$parentConfigurationButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="188" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Gizmo_02.blp" />
						<PushedTexture file="Interface\ICONS\INV_Gizmo_02.blp" />
						<Scripts>
							<OnClick>
								SOTA_OpenConfigurationUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ОКНО НАСТРОЕК");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Невидимой фрейм для перетаскивания (СИНИЙ ДЛЯ ТЕСТА) -->
					<Frame name="$parentButtonsDragArea">
						<Size>
							<AbsDimension x="231" y="90" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
							<Color r="0" g="0" b="1" a="0" />
						</Backdrop>
						<Scripts>
							<OnLoad>
								this:SetMovable(true)
								this:RegisterForDrag("LeftButton")
							</OnLoad>
							<OnDragStart>
								DashboardUIFrame:StartMoving()
							</OnDragStart>
							<OnDragStop>
								DashboardUIFrame:StopMovingOrSizing()
							</OnDragStop>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>

			<!-- Нижняя панель с информацией о мастер-лутере -->
			<Frame name="$parentMasterInfo">
				<Size>
					<AbsDimension x="240" y="32" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="105" />
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop
                    edgeFile="Interface\Tooltips\UI-Tooltip-Border"
                    tile="true"
                    bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                >
					<BackgroundInsets>
						<AbsInset left="4" right="4" top="4" bottom="4" />
					</BackgroundInsets>
					<EdgeSize>
						<AbsValue val="16" />
					</EdgeSize>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
				</Backdrop>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="SOTA_MasterInfoText" inherits="SOTA_Font_Normal" text="МАСТЕР ЛУТЕР: (отсутствует)" justifyH="CENTER">
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="0" y="0" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<!-- Невидимой фрейм для перетаскивания (КРАСНЫЙ ДЛЯ ТЕСТА) -->
					<Frame name="$parentDragArea">
						<Size>
							<AbsDimension x="240" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
							<Color r="1" g="0" b="0" a="0" />
						</Backdrop>
						<Scripts>
							<OnLoad>
								this:SetMovable(true)
								this:RegisterForDrag("LeftButton")
							</OnLoad>
							<OnDragStart>
								DashboardUIFrame:StartMoving()
							</OnDragStart>
							<OnDragStop>
								DashboardUIFrame:StopMovingOrSizing()
							</OnDragStop>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				this:SetMovable(true)
				this:SetUserPlaced(true)
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Dummy event frame -->
	<Frame name="SOTAEventFrame">
		<Scripts>
			<OnLoad>
				if (SOTA_OnLoad) then
				SOTA_OnLoad();
				end
			</OnLoad>
			<OnEvent>
				if (SOTA_OnEvent) then
				SOTA_OnEvent(event, arg1, arg2, arg3, arg4, arg5);
				end
			</OnEvent>
			<OnUpdate>
				if (SOTA_OnTimer) then
				SOTA_OnTimer(arg1);
				end
			</OnUpdate>
		</Scripts>
	</Frame>

	<!-- SOTA Tooltip Frame -->
	<Frame name="SOTA_TooltipFrame" parent="UIParent" toplevel="true" frameStrata="TOOLTIP" hidden="true">
		<Size>
			<AbsDimension x="200" y="50" />
		</Size>
		<Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true" bgFile="Interface\Tooltips\UI-Tooltip-Background">
			<BackgroundInsets>
				<AbsInset left="4" right="4" top="4" bottom="4" />
			</BackgroundInsets>
			<EdgeSize>
				<AbsValue val="16" />
			</EdgeSize>
			<TileSize>
				<AbsValue val="16" />
			</TileSize>
			<Color r="0.1" g="0.1" b="0.1" a="1" />
		</Backdrop>
		<Scripts>
			<OnShow>
				this:SetBackdropColor(0, 0, 0, 1);
			</OnShow>
		</Scripts>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="SOTA_TooltipText" inherits="SOTA_Font_Orange" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="12" y="-6" />
							</Offset>
						</Anchor>
						<Anchor point="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="-8" y="8" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>