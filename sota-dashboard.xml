<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Script file="sota-dashboard.lua" />

	<!-- Кириллические шрифты -->
	<Font name="SOTA_Font_Title" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="16" />
		<Color r="1" g="1" b="1" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Normal" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="12" />
		<Color r="1" g="1" b="1" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Small" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="10" />
		<Color r="0.7" g="0.7" b="0.7" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>
	<Font name="SOTA_Font_Orange" font="Interface\AddOns\SOTA\assets\fonts\ARIALN.ttf" virtual="true">
		<FontHeight val="12" />
		<Color r="0.784" g="0.294" b="0.192" />
		<Shadow>
			<Offset>
				<AbsDimension x="1" y="-1" />
			</Offset>
			<Color r="0" g="0" b="0" />
		</Shadow>
	</Font>

	<!-- SOTA Dashboard -->
	<Frame name="DashboardUIFrame" parent="UIParent" toplevel="true" hidden="true" frameStrata="HIGH">
		<Size>
			<AbsDimension x="280" y="85" />
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset x="312" y="-118" />
			</Anchor>
		</Anchors>
		<Frames>

			<!-- Верхняя панель с информацией о мастер-лутере -->
			<Frame name="$parentMasterInfo">
				<Size>
					<AbsDimension x="232" y="24" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="109" />
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop bgFile="Interface\Buttons\WHITE8X8" tile="true" edgeFile="Interface\Buttons\WHITE8X8">
					<BackgroundInsets>
						<AbsInset left="0" right="0" top="0" bottom="0" />
					</BackgroundInsets>
					<EdgeSize>
						<AbsValue val="1" />
					</EdgeSize>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
				</Backdrop>
				<Scripts>
					<OnLoad>
					    this:SetBackdropColor(0.098, 0.098, 0.098, 1);
						this:SetBackdropBorderColor(0.251, 0.251, 0.251, 1);
					</OnLoad>
				</Scripts>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="SOTA_MasterInfoText" inherits="SOTA_Font_Normal" text="МАСТЕР ЛУТЕР: НЕ НАЗНАЧЕН" justifyH="CENTER">
							<Anchors>
								<Anchor point="CENTER">
									<Offset>
										<AbsDimension x="0" y="2" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<!-- Невидимой фрейм для перетаскивания верхней панели (КРАСНЫЙ ДЛЯ ТЕСТА) -->
					<Frame name="$parentDragArea">
						<Size>
							<AbsDimension x="180" y="24" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="26" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
							<Color r="1" g="0" b="0" a="0" />
						</Backdrop>
						<Scripts>
							<OnLoad>
								this:SetMovable(true);
								this:RegisterForDrag("LeftButton");
							</OnLoad>
							<OnDragStart>
								DashboardUIFrame:StartMoving();
							</OnDragStart>
							<OnDragStop>
								DashboardUIFrame:StopMovingOrSizing();
							</OnDragStop>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>

			<!-- Кнопка-подсказка с правилами DKP (левая сторона) -->
			<Button name="$parentDKPRulesButton">
				<Size>
					<AbsDimension x="18" y="18" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeTo="$parentMasterInfo" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="5" y="3" />
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\AddOns\SOTA\assets\img\complete.tga" />
				<HighlightTexture file="Interface\AddOns\SOTA\assets\img\complete_c.tga" />
				<Scripts>
					<OnEnter>
						SOTA_ShowDashboardToolTip(this, SOTA_GetDKPRulesText(), true);
					</OnEnter>
					<OnLeave>
						SOTA_HideDashboardToolTip(this);
					</OnLeave>
				</Scripts>
			</Button>

			<!-- Кнопка сворачивания/разворачивания панели кнопок -->
			<Button name="$parentToggleButtons">
				<Size>
					<AbsDimension x="18" y="18" />
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentMasterInfo" relativePoint="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-5" y="3" />
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\AddOns\SOTA\assets\img\bottom.tga" />
				<PushedTexture file="Interface\AddOns\SOTA\assets\img\bottom.tga" />
				<Scripts>
					<OnLoad>
						this:GetNormalTexture():SetVertexColor(1, 1, 1, 0.35);
						this:GetPushedTexture():SetVertexColor(1, 1, 1, 0.5);
					</OnLoad>
					<OnClick>
						SOTA_ToggleDashboardButtons();
					</OnClick>
					<OnEnter>
						SOTA_ShowDashboardToolTip(this, "СВЕРНУТЬ/РАЗВЕРНУТЬ ПАНЕЛЬ");
					</OnEnter>
					<OnLeave>
						SOTA_HideDashboardToolTip(this);
					</OnLeave>
				</Scripts>
			</Button>

			<!-- Общая панель с кнопками (10 кнопок в 2 ряда) -->
			<Frame name="$parentButtons">
				<Size>
				<AbsDimension x="232" y="90" />
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
						<AbsDimension x="24" y="22" />
						</Offset>
					</Anchor>
				</Anchors>
				<Backdrop bgFile="Interface\Buttons\WHITE8X8" tile="true" edgeFile="Interface\Buttons\WHITE8X8">
					<BackgroundInsets>
						<AbsInset left="0" right="0" top="0" bottom="0" />
					</BackgroundInsets>
					<EdgeSize>
						<AbsValue val="1" />
					</EdgeSize>
					<TileSize>
						<AbsValue val="16" />
					</TileSize>
				</Backdrop>
				<Scripts>
					<OnLoad>
					    this:SetBackdropColor(0.098, 0.098, 0.098, 1);
						this:SetBackdropBorderColor(0.251, 0.251, 0.251, 1);
					</OnLoad>
				</Scripts>
				<Frames>
					<!-- ВЕРХНИЙ РЯД (бонусы DKP) -->
					<!-- Button 1: Приветственное DKP -->
					<Button name="$parentWelcomeDKPButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="12" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Ability_Mage_IncantersAbsorbtion" />
						<PushedTexture file="Interface\ICONS\Ability_Mage_IncantersAbsorbtion" />
						<Scripts>
							<OnClick>
								SOTA_WelcomeDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ ПРИВЕТСТВЕННОЕ DKP");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 2: Без вайпов -->
					<Button name="$parentNoWipeButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="56" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_Crusade" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_Crusade" />
						<Scripts>
							<OnClick>
								SOTA_NoWipeDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА ПРОХОД БЕЗ ВАЙПОВ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 3: Без смертей -->
					<Button name="$parentNoDeathButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="100" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_Redemption" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_Redemption" />
						<Scripts>
							<OnClick>
								SOTA_NoDeathDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА ПРОХОД БЕЗ СМЕРТЕЙ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 4: Рекорд времени -->
					<Button name="$parentRecordButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="144" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_BorrowedTime" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_BorrowedTime" />
						<Scripts>
							<OnClick>
								SOTA_RecordDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "НАЧИСЛИТЬ DKP ЗА РЕКОРД ВРЕМЕНИ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 5: Начислить DKP рейду -->
					<Button name="$parentRaidDKPButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="188" y="-12" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_Coin_02" />
						<PushedTexture file="Interface\ICONS\INV_Misc_Coin_02" />
						<Scripts>
							<OnClick>
								SOTA_ShareBossDKP();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ДОБАВИТЬ УКАЗАННОЕ КОЛИЧЕСТВО DKP КАЖДОМУ УЧАСТНИКУ РЕЙДА");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>

					<!-- НИЖНИЙ РЯД (основные функции) -->
					<!-- Button 6: Запрос мастер лутера -->
					<Button name="$parentSOTAMasterButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="12" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Spell_Holy_SpiritualGuidence" />
						<PushedTexture file="Interface\ICONS\Spell_Holy_SpiritualGuidence" />
						<Scripts>
							<OnClick>
								SOTA_RequestSOTAMaster();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ЗАПРОСИТЬ СТАТУС МАСТЕР-ЛУТЕРА");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 7: Отслеживание лута -->
					<Button name="$parentLootTrackerButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="56" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Misc_pocketwatch_02" />
						<PushedTexture file="Interface\ICONS\INV_Misc_pocketwatch_02" />
						<Scripts>
							<OnClick>
								SOTA_LootTracker_ToggleUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТСЛЕЖИВАНИЕ ЛУТА");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 8: Журнал транзакций -->
					<Button name="$parentTransactionLogButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="100" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\BtnHolyScriptures" />
						<PushedTexture file="Interface\ICONS\BtnHolyScriptures" />
						<Scripts>
							<OnClick>
								SOTA_OpenTransauctionUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ЖУРНАЛ ТРАНЗАКЦИЙ");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 9: Очередь в рейд -->
					<Button name="$parentRaidQueueButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="144" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\Achievement_Rat" />
						<PushedTexture file="Interface\ICONS\Achievement_Rat" />
						<Scripts>
							<OnClick>
								SOTA_OpenRaidQueueUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ОЧЕРЕДЬ В РЕЙД");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Button 10: Настройки -->
					<Button name="$parentConfigurationButton" inherits="ActionButtonTemplate" frameStrata="HIGH" hidden="false">
						<Size>
							<AbsDimension x="32" y="32" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="188" y="-48" />
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture file="Interface\ICONS\INV_Gizmo_02" />
						<PushedTexture file="Interface\ICONS\INV_Gizmo_02" />
						<Scripts>
							<OnClick>
								SOTA_OpenConfigurationUI();
							</OnClick>
							<OnEnter>
								SOTA_ShowDashboardToolTip(this, "ОТКРЫТЬ ОКНО НАСТРОЕК");
							</OnEnter>
							<OnLeave>
								SOTA_HideDashboardToolTip(this);
							</OnLeave>
							<OnMouseDown>
								this:GetPushedTexture():SetDesaturated(true);
							</OnMouseDown>
							<OnMouseUp>
								this:GetPushedTexture():SetDesaturated(false);
							</OnMouseUp>
						</Scripts>
					</Button>
					<!-- Невидимой фрейм для перетаскивания (СИНИЙ ДЛЯ ТЕСТА) -->
					<Frame name="$parentButtonsDragArea">
						<Size>
							<AbsDimension x="231" y="90" />
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background">
							<Color r="0" g="0" b="1" a="0" />
						</Backdrop>
						<Scripts>
							<OnLoad>
								this:SetMovable(true);
								this:RegisterForDrag("LeftButton");
							</OnLoad>
							<OnDragStart>
								DashboardUIFrame:StartMoving();
							</OnDragStart>
							<OnDragStop>
								DashboardUIFrame:StopMovingOrSizing();
							</OnDragStop>
						</Scripts>
					</Frame>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				this:SetMovable(true);
				this:SetUserPlaced(true);
			</OnLoad>
			<OnShow>
				if SOTA_InitializeDashboardButtonsState then
					SOTA_InitializeDashboardButtonsState();
				end
			</OnShow>
		</Scripts>
	</Frame>

	<!-- Dummy event frame -->
	<Frame name="SOTAEventFrame">
		<Scripts>
			<OnLoad>
				if (SOTA_OnLoad) then
				SOTA_OnLoad();
				end
			</OnLoad>
			<OnEvent>
				if (SOTA_OnEvent) then
				SOTA_OnEvent(event, arg1, arg2, arg3, arg4, arg5);
				end
			</OnEvent>
			<OnUpdate>
				if (SOTA_OnTimer) then
				SOTA_OnTimer(arg1);
				end
			</OnUpdate>
		</Scripts>
	</Frame>

	<!-- SOTA Tooltip Frame -->
	<Frame name="SOTA_TooltipFrame" parent="UIParent" toplevel="true" frameStrata="TOOLTIP" hidden="true">
		<Size>
			<AbsDimension x="200" y="50" />
		</Size>
		<Backdrop bgFile="Interface\Buttons\WHITE8X8" tile="true" edgeFile="Interface\Buttons\WHITE8X8">
			<BackgroundInsets>
				<AbsInset left="0" right="0" top="0" bottom="0" />
			</BackgroundInsets>
			<EdgeSize>
				<AbsValue val="1" />
			</EdgeSize>
			<TileSize>
				<AbsValue val="16" />
			</TileSize>
		</Backdrop>
		<Scripts>
			<OnLoad>
				this:SetBackdropColor(0.098, 0.098, 0.098, 1);
				this:SetBackdropBorderColor(0.251, 0.251, 0.251, 1);
			</OnLoad>
		</Scripts>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="SOTA_TooltipText" inherits="SOTA_Font_Normal" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="12" y="-6" />
							</Offset>
